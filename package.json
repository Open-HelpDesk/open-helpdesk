{
  "name": "open-helpdesk",
  "version": "0.2.3",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @openhelpdesk/db db:generate",
    "db:migrate": "pnpm --filter @openhelpdesk/db db:migrate",
    "db:seed": "pnpm --filter @openhelpdesk/db db:seed",
    "db:relocalize": "pnpm --filter @openhelpdesk/db db:relocalize",
    "db:seed:auth": "pnpm --filter @openhelpdesk/auth seed",
    "test": "vitest run --project unit --coverage",
    "test:db": "vitest run --project db",
    "test:watch": "vitest --project unit",
    "test:fast": "vitest run --project unit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "next": ">=15.5.24",
      "sharp": ">=0.35.4",
      "postcss": ">=8.5.18",
      "nodemailer": ">=9.1.0",
      "deepmerge-ts": ">=8.0.0"
    }
  }
}
