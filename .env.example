# ------------------------------------------------------------------------
# Self-hosting in production: compose.yaml (repository root) builds and starts
# postgres + redis + minio + web + worker + migrations. Three commands:
#   git clone … && cd open-helpdesk
#   cp .env.example .env   # fill in BETTER_AUTH_SECRET and ENCRYPTION_KEY
#   docker compose up -d   # http://localhost:3000
# The internal hosts (postgres, redis, minio) are pinned by compose.yaml and
# take precedence over the development values below.
# ------------------------------------------------------------------------

# Acme demo workspace, installed on the first start of the production compose
# stack (login marie.dupont@acme.example / demo-openhelpdesk).
# Switch to false once your own agents exist.
SEED_DEMO=true

# Runtime edition: self-hosted (default) or cloud. Self-hosted unlocks the
# whole AGPL core, with no seat quota; the /ee features stay locked. With
# "cloud", entitlements are resolved by an external control plane instead.
# OPENHELPDESK_EDITION=self-hosted

# Database (docker/docker-compose.yml provides these defaults; host ports are
# shifted — 5439/6380 — so the stack can coexist with other local projects)
DATABASE_URL=postgres://openhelpdesk:openhelpdesk@localhost:5439/openhelpdesk

# Redis — BullMQ queues (SLA, email ingestion, automations, provisioning)
REDIS_URL=redis://localhost:6380

# Multi-tenant resolution: {slug}.$BASE_DOMAIN → tenant "slug".
# In development, acme.localhost:3000 works in modern browsers.
BASE_DOMAIN=localhost:3000
# Single-tenant self-hosting: the tenant served on the bare domain.
DEFAULT_TENANT_SLUG=acme

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me
# Control-plane deployments: session cookie shared between www. and the tenant
# subdomains.
# AUTH_COOKIE_DOMAIN=
# Control-plane deployments: password sign-up requires a verified email.
# REQUIRE_EMAIL_VERIFICATION=false

# Encryption of secrets at rest (SMTP passwords, API keys, SSO secrets).
# 32 random bytes: openssl rand -base64 32
ENCRYPTION_KEY=change-me-32-bytes-minimum-please

# Email — ingestion (webhook /api/ingress/email)
MAIL_INGRESS_SECRET=dev-ingress-secret

# Domain of the provided email addresses: support@{slug}.MANAGED_MAIL_DOMAIN.
# Falls back to BASE_DOMAIN without its port.
# MANAGED_MAIL_DOMAIN=

# Control-plane deployments: the "workspace not found" 404 points here so a
# visitor can create one.
# SIGNUP_URL=

# Control-plane deployments: private gateway of the control plane. The product
# asks it for a session URL and redirects the user there — it never holds any
# third-party credentials of its own.
# CLOUD_GATEWAY_URL=
# CLOUD_GATEWAY_SECRET=

# Email — sending. Each workspace picks its provider in
# Settings → Channels → Email (stored encrypted in the database). The variables
# below only act as an instance-wide FALLBACK when a workspace has configured
# nothing: single-tenant self-hosting, or the instance default address.
MAIL_FROM=support@open-helpdesk.local
# SMTP (also covers Brevo, Mailjet, Mailgun, SES, Postmark… through their relay)
# SMTP_HOST=localhost
# SMTP_PORT=1026
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Native APIs (pick one; the first one filled in wins)
# RESEND_API_KEY=
# BREVO_API_KEY=
# MAILJET_API_KEY=
# MAILJET_API_SECRET=

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY_ID=openhelpdesk
S3_SECRET_ACCESS_KEY=openhelpdesk
S3_BUCKET=attachments
