# ------------------------------------------------------------------------
# Auto-hébergement en production : compose.yaml (racine) construit et lance
# postgres + redis + minio + web + worker + migrations. Trois commandes :
#   git clone … && cd open-helpdesk
#   cp .env.example .env   # renseigner BETTER_AUTH_SECRET et ENCRYPTION_KEY
#   docker compose up -d   # http://localhost:3000
# Les hôtes internes (postgres, redis, minio) sont fixés par compose.yaml et
# priment sur les valeurs de développement ci-dessous.
# ------------------------------------------------------------------------

# Workspace de démonstration Acme installé au premier démarrage du compose de
# production (connexion marie.dupont@acme.example / demo-openhelpdesk).
# Passez à false une fois vos agents créés.
SEED_DEMO=true

# Édition d'exécution (specs/01 § 6) : self-hosted (défaut) ou cloud.
# En self-hosted, tout le cœur AGPL est débloqué sans plan ni quota de sièges ;
# les fonctionnalités /ee restent verrouillées. « cloud » active le gating par plan.
# OPENHELPDESK_EDITION=self-hosted

# Base de données (docker/docker-compose.yml fournit ces valeurs par défaut ;
# ports hôte décalés — 5439/6380 — pour cohabiter avec d'autres projets locaux)
DATABASE_URL=postgres://openhelpdesk:openhelpdesk@localhost:5439/openhelpdesk

# Redis — files BullMQ (SLA, ingestion email, automatisations, provisioning)
REDIS_URL=redis://localhost:6380

# Résolution multi-tenant : {slug}.$BASE_DOMAIN → tenant "slug".
# En dev, acme.localhost:3000 fonctionne dans les navigateurs modernes.
BASE_DOMAIN=localhost:3000
# Auto-hébergé mono-tenant : tenant servi sur le domaine nu.
DEFAULT_TENANT_SLUG=acme

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me
# Cloud : cookie de session partagé entre www. et les sous-domaines tenants.
# AUTH_COOKIE_DOMAIN=
# Cloud : l'inscription par mot de passe exige un email vérifié.
# REQUIRE_EMAIL_VERIFICATION=false

# Chiffrement des secrets au repos (mots de passe SMTP, clés d'API, secrets SSO).
# 32 octets aléatoires : openssl rand -base64 32
ENCRYPTION_KEY=change-me-32-bytes-minimum-please

# Email — ingestion (webhook /api/ingress/email)
MAIL_INGRESS_SECRET=dev-ingress-secret

# Domaine des adresses email fournies : support@{slug}.MANAGED_MAIL_DOMAIN.
# Repli : BASE_DOMAIN sans port. En cloud : open-helpdesk.com.
# MANAGED_MAIL_DOMAIN=

# Cloud uniquement : la page 404 « workspace introuvable » renvoie vers le signup.
# SIGNUP_URL=

# Cloud uniquement : gateway billing privée (sessions Stripe servies par la console).
# CLOUD_GATEWAY_URL=
# CLOUD_GATEWAY_SECRET=

# Email — envoi. Chaque workspace configure son fournisseur dans
# Paramètres → Canaux → Email (stocké chiffré en base). Les variables ci-dessous ne
# servent que de REPLI d'instance quand un workspace n'a rien configuré :
#   auto-hébergement mono-tenant, ou adresse par défaut du cloud.
MAIL_FROM=support@open-helpdesk.local
# SMTP (couvre aussi Brevo, Mailjet, Mailgun, SES, Postmark… via leur relais)
# SMTP_HOST=localhost
# SMTP_PORT=1026
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# API natives (au choix, la première renseignée gagne)
# RESEND_API_KEY=
# BREVO_API_KEY=
# MAILJET_API_KEY=
# MAILJET_API_SECRET=

# Stockage S3-compatible (MinIO en local)
S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY_ID=openhelpdesk
S3_SECRET_ACCESS_KEY=openhelpdesk
S3_BUCKET=attachments
